<Window x:Class="WpfGallery.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfGallery"
        mc:Ignorable="d"
        Title="Галерея зображень" Height="600" Width="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <WrapPanel Margin="10">
            <Button Content="Оберіть папку..." Padding="15,5"
                    Name="SelectFolder" Click="SelectFolder_Click"/>
            <Button Content="Очистити" Padding="10,5"
        Name="Clear" Click="Clear_Click"/>
            <TextBlock x:Name="PathText" Margin="15,0,20,0" VerticalAlignment="Center"/>
            <TextBlock Text="Масштаб: " VerticalAlignment="Center" Margin="0,0,5,0"/>
            <Slider x:Name="SliderPhoto" Width="150" VerticalAlignment="Center"
                    Minimum="0.5" Maximum="3" Value="1" 
                    TickFrequency="0.1" IsSnapToTickEnabled="True"/>
        </WrapPanel>

        <ListBox Name="GalleryList" Grid.Row="1" Margin="10"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">

            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Image Source="{Binding}" Width="150" Height="150"
                           Stretch="UniformToFill" Margin="5"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.LayoutTransform>
                            <ScaleTransform 
                                ScaleX="{Binding ElementName=SliderPhoto, Path=Value}" 
                                ScaleY="{Binding ElementName=SliderPhoto, Path=Value}"/>
                        </Image.LayoutTransform>
                    </Image>
                </DataTemplate>
            </ListBox.ItemTemplate>

        </ListBox>
    </Grid>
</Window>